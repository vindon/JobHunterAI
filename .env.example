# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in real values
#
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ─────────────────────────────────────────────────────────────────

# Tavily Search API (required — free tier: 1,000 searches/month)
# Get your key at: https://app.tavily.com
# Free tier is sufficient for 30+ daily runs per month.
TAVILY_API_KEY=your_tavily_api_key_here


# ── Optional — LangSmith observability (strongly recommended) ────────────────
# Free tier: 5,000 traces/month — enough for 6+ months of daily runs
# Sign up at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=JobHunterAI


# ── Optional — only if using Claude API instead of local Ollama ──────────────
# By default JobHunterAI uses Ollama/Mistral (fully local, no cost).
# Uncomment and fill this in ONLY if you switch to Claude for parse/rank nodes.
# Get a key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_key_here


# ── Optional — custom output directory ───────────────────────────────────────
# By default results are saved to ~/Documents/JobHunterAI/
# Uncomment to override:
# OUTPUT_DIR=/path/to/your/preferred/output/directory
